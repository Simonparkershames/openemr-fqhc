{#
  Role workspace home (issues #33, #39).

  The shared workspace template. Front desk, clinical support, and provider
  redirect to purpose-built pages before reaching it, so in practice this now
  renders the manager/quality home: a page header, the UDS data-health metric
  with its open-gap breakdown, a year-over-year utilization snapshot, and the
  report/worklist/snapshot shortcuts.

  Context:
    workspace   — {roleKey, roleLabel, heading, tagline} from the resolved
                  OpenEMR\FQHC\Workspace\Workspace.
    cards       — list of {title, description, url, ctaLabel}; urls are
                  absolute (webroot already prefixed by the entry point).
    dataHealth  — null, or {year, total, gapCounts, worklistUrl} for the live
                  UDS data-health metric; gapCounts is a list of
                  {label, count} for the gap types that occur.
    utilization — null, or {year, priorYear, currentVisits, priorVisits,
                  visitsDelta, hasActivity, categories} where categories is a
                  list of {label, current, prior, delta} for active service
                  lines. The year-over-year UDS Table 5 utilization snapshot.

  TwigContainer disables autoescaping, so values are escaped explicitly.

  @license https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
<div class="fqhc-root">
  <div class="fqhc-container">

    <fqhc-page-header
      icon="{{ workspace.icon|e('html_attr') }}"
      heading="{{ workspace.heading|e('html_attr') }}"
      subheading="{{ workspace.tagline|e('html_attr') }}">
      <div slot="actions" class="fqhc-cluster">
        <fqhc-status-badge icon="{{ workspace.icon|e('html_attr') }}">{{ workspace.roleLabel|e('html') }}</fqhc-status-badge>
      </div>
    </fqhc-page-header>

    <div class="fqhc-stack">

      {% if dataHealth %}
        <fqhc-card icon="worklist" heading="UDS data health — {{ dataHealth.year }}">
          {% if dataHealth.total == 0 %}
            <fqhc-status-badge variant="success">No data-quality gaps</fqhc-status-badge>
            <p class="fqhc-note">Every {{ dataHealth.year }} patient has complete UDS demographics, income, and payer data.</p>
          {% else %}
            <fqhc-status-badge variant="warning">{{ dataHealth.total }} patient(s) with gaps</fqhc-status-badge>
            <p class="fqhc-note">Gaps in demographics, income, or payer mapping distort UDS counts until resolved.</p>
            {% if dataHealth.gapCounts is not empty %}
              <div class="fqhc-table-wrap">
                <table class="fqhc-table">
                  <thead><tr><th>Gap type</th><th>Patients</th></tr></thead>
                  <tbody>
                    {% for gap in dataHealth.gapCounts %}
                      <tr>
                        <td>{{ gap.label|e('html') }}</td>
                        <td data-label="Patients">{{ gap.count }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}
            <a class="fqhc-button" href="{{ dataHealth.worklistUrl|e('html_attr') }}">Open eligibility worklist</a>
          {% endif %}
        </fqhc-card>
      {% endif %}

      {% if utilization %}
        <fqhc-card heading="Utilization — {{ utilization.year }} vs {{ utilization.priorYear }}">
          {% if not utilization.hasActivity %}
            <fqhc-empty-state message="No visits recorded for {{ utilization.year }} or {{ utilization.priorYear }}."></fqhc-empty-state>
          {% else %}
            <fqhc-status-badge variant="{{ utilization.visitsDelta >= 0 ? 'success' : 'warning' }}">
              {{ utilization.currentVisits }} visit(s) in {{ utilization.year }}
              ({{ utilization.visitsDelta > 0 ? '+' : '' }}{{ utilization.visitsDelta }} vs {{ utilization.priorYear }})
            </fqhc-status-badge>
            <p class="fqhc-note">Countable UDS Table 5 visits by service line, this reporting year against last.</p>
            <div class="fqhc-table-wrap">
              <table class="fqhc-table">
                <thead>
                  <tr><th>Service line</th><th>{{ utilization.year }}</th><th>{{ utilization.priorYear }}</th><th>Change</th></tr>
                </thead>
                <tbody>
                  {% for category in utilization.categories %}
                    <tr>
                      <td>{{ category.label|e('html') }}</td>
                      <td data-label="{{ utilization.year }}">{{ category.current }}</td>
                      <td data-label="{{ utilization.priorYear }}">{{ category.prior }}</td>
                      <td data-label="Change">{{ category.delta > 0 ? '+' : '' }}{{ category.delta }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
                <tfoot>
                  <tr>
                    <th>All visits</th>
                    <th data-label="{{ utilization.year }}">{{ utilization.currentVisits }}</th>
                    <th data-label="{{ utilization.priorYear }}">{{ utilization.priorVisits }}</th>
                    <th data-label="Change">{{ utilization.visitsDelta > 0 ? '+' : '' }}{{ utilization.visitsDelta }}</th>
                  </tr>
                </tfoot>
              </table>
            </div>
          {% endif %}
        </fqhc-card>
      {% endif %}

      <div class="fqhc-grid">
        {% for card in cards %}
          <fqhc-card icon="{{ card.icon|e('html_attr') }}" heading="{{ card.title|e('html_attr') }}">
            <p>{{ card.description|e('html') }}</p>
            <a class="fqhc-button" href="{{ card.url|e('html_attr') }}">
              <fqhc-icon class="fqhc-icon-lead" name="{{ card.icon|e('html_attr') }}"></fqhc-icon>{{ card.ctaLabel|e('html') }}
            </a>
          </fqhc-card>
        {% endfor %}
      </div>

    </div>

  </div>
</div>
