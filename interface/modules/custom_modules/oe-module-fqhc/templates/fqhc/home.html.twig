{#
  Role workspace home (issue #33).

  Shared template every role workspace renders through: a page header naming
  the role, an optional live data-health card (manager/quality only for now),
  and the workspace's card set from the registry.

  Context:
    workspace  — {roleKey, roleLabel, heading, tagline} from the resolved
                 OpenEMR\FQHC\Workspace\Workspace.
    cards      — list of {title, description, url, ctaLabel}; urls are
                 absolute (webroot already prefixed by the entry point).
    dataHealth — null, or {year, total, worklistUrl} for the live UDS
                 data-health metric.

  TwigContainer disables autoescaping, so values are escaped explicitly.

  @license https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
<div class="fqhc-root">
  <div class="fqhc-container">

    <fqhc-page-header
      icon="{{ workspace.icon|e('html_attr') }}"
      heading="{{ workspace.heading|e('html_attr') }}"
      subheading="{{ workspace.tagline|e('html_attr') }}">
      <div slot="actions" class="fqhc-cluster">
        <fqhc-status-badge icon="{{ workspace.icon|e('html_attr') }}">{{ workspace.roleLabel|e('html') }}</fqhc-status-badge>
        {# The choice is stored per browser, so setting it here applies to every FQHC surface. #}
        <fqhc-theme-toggle></fqhc-theme-toggle>
      </div>
    </fqhc-page-header>

    <div class="fqhc-stack">

      {% if dataHealth %}
        <fqhc-card icon="worklist" heading="UDS data health — {{ dataHealth.year }}">
          {% if dataHealth.total == 0 %}
            <fqhc-status-badge variant="success">No data-quality gaps</fqhc-status-badge>
            <p class="fqhc-note">Every {{ dataHealth.year }} patient has complete UDS demographics, income, and payer data.</p>
          {% else %}
            <fqhc-status-badge variant="warning">{{ dataHealth.total }} patient(s) with gaps</fqhc-status-badge>
            <p class="fqhc-note">Gaps in demographics, income, or payer mapping distort UDS counts until resolved.</p>
            <a class="fqhc-button" href="{{ dataHealth.worklistUrl|e('html_attr') }}">Open eligibility worklist</a>
          {% endif %}
        </fqhc-card>
      {% endif %}

      <div class="fqhc-grid">
        {% for card in cards %}
          <fqhc-card icon="{{ card.icon|e('html_attr') }}" heading="{{ card.title|e('html_attr') }}">
            <p>{{ card.description|e('html') }}</p>
            <a class="fqhc-button" href="{{ card.url|e('html_attr') }}">
              <fqhc-icon class="fqhc-icon-lead" name="{{ card.icon|e('html_attr') }}"></fqhc-icon>{{ card.ctaLabel|e('html') }}
            </a>
          </fqhc-card>
        {% endfor %}
      </div>

    </div>

  </div>
</div>
